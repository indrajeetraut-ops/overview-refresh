{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talium.dev/contracts/causal-graph/query_spec.schema.json",
  "title": "Talium causal graph QuerySpec",
  "type": "object",
  "required": ["version", "scope", "select", "return"],
  "properties": {
    "version": {"const": "1"},
    "scope": {"$ref": "#/$defs/scope"},
    "select": {"$ref": "#/$defs/select"},
    "walk": {"type": "array", "items": {"$ref": "#/$defs/walk"}},
    "group_by": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "aggregates": {"type": "array", "items": {"$ref": "#/$defs/aggregate"}},
    "having": {"type": "string"},
    "order_by": {"type": "array", "items": {"$ref": "#/$defs/order_by"}},
    "limit": {"type": "integer", "minimum": 1, "maximum": 10000},
    "return": {"$ref": "#/$defs/return"}
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["self", "tree", "subagents", "session"]},
        "session_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "select": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["Node", "Turn", "UserPrompt", "Assistant", "Tool", "Spawn", "Compaction"]},
        "where": {"type": "string"}
      },
      "additionalProperties": false
    },
    "walk": {
      "type": "object",
      "required": ["relation", "type"],
      "properties": {
        "relation": {"enum": ["within", "contains", "spawned"]},
        "type": {"enum": ["Turn", "UserPrompt", "Assistant", "Tool", "Spawn"]},
        "where": {"type": "string"}
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "required": ["name", "function"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "function": {"enum": ["COUNT", "SUM", "AVG", "MIN", "MAX", "MEDIAN"]},
        "field": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "order_by": {
      "type": "object",
      "required": ["field", "direction"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "direction": {"enum": ["asc", "desc"]}
      },
      "additionalProperties": false
    },
    "return": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["nodes", "groups", "aggregate"]},
        "verbosity": {"enum": ["ref", "summary", "full"]},
        "fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "include_members": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
